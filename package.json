{
  "name": "plato-observation-wiki",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^24.10.1",
      "typescript": "^5.9.3"
    }
  },
  "scripts": {
    "cli": "bun packages/cli/src/cli.ts",
    "harness": "bun packages/cli/src/cli.ts",
    "commentary:structural-remediation": "bun scripts/commentary/structural-remediation-batch.ts",
    "migrate:ledger-yaml": "bun scripts/wiki/migrate-fenced-records.ts",
    "transcripts": "bun packages/cli/src/cli.ts transcripts",
    "usage": "bun packages/cli/src/cli.ts usage",
    "completeness": "bun run derive && bun packages/cli/src/cli.ts completeness",
    "release:audit": "bun packages/cli/src/cli.ts release:audit",
    "release:provenance": "bun scripts/release/generate-provenance.ts",
    "public:export": "bun scripts/release/export-public-tree.ts",
    "test": "bun run derive && bun run --sequential --workspaces test",
    "typecheck": "bun run --workspaces typecheck",
    "validate": "bun run derive && bun packages/cli/src/cli.ts validate",
    "ci": "bun scripts/ci.ts",
    "lint": "oxlint --deny-warnings packages scripts",
    "build": "bun run derive && bun packages/cli/src/cli.ts site",
    "derive": "bun packages/cli/src/cli.ts derive tokens"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "1.81.0",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
